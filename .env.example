# ==============================================================================
# Inclined Careers - Email & Server Environment Configuration
# ==============================================================================

# Backend Server Port
PORT=3000

# ------------------------------------------------------------------------------
# SMTP Configuration
# ------------------------------------------------------------------------------
# 1. If using Google Workspace / Gmail:
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=465
#    SMTP_USER=info@inclinedcareers.in
#    SMTP_PASSWORD=your-16-character-app-password
#    (Generate in Google Account -> Security -> 2-Step Verification -> App passwords)
#
# 2. If using Zoho Mail:
#    SMTP_HOST=smtppro.zoho.in
#    SMTP_PORT=465
#    SMTP_USER=info@inclinedcareers.in
#    SMTP_PASSWORD=your-zoho-app-password
#
# 3. If using Microsoft 365 / Outlook:
#    SMTP_HOST=smtp.office365.com
#    SMTP_PORT=587
#    SMTP_USER=info@inclinedcareers.in
#    SMTP_PASSWORD=your-app-password
#
# 4. If using Hostinger / cPanel webmail:
#    SMTP_HOST=smtp.hostinger.com
#    SMTP_PORT=465
#    SMTP_USER=info@inclinedcareers.in
#    SMTP_PASSWORD=your-mailbox-password
# ------------------------------------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@inclinedcareers.in
SMTP_PASSWORD=

# Sender and Recipient Email Addresses
MAIL_FROM=info@inclinedcareers.in
MAIL_TO=info@inclinedcareers.in
